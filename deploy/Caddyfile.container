# HTTP inside the container. Put a TLS reverse proxy in front of port 80.
:80 {
    root * /srv/assense.com

    @german {
        path /
        header_regexp Accept-Language "(?i)(^|,)[[:space:]]*de(-[a-z0-9]+)*([[:space:]]*;[[:space:]]*q=(1(\.0+)?|0\.[0-9]*[1-9][0-9]*))?[[:space:]]*(,|$)"
    }

    route {
        header / Vary Accept-Language
        redir @german /de/ 302
        redir / /en/ 302
        file_server
    }
}
